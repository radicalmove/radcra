[Unit]
Description=Isolated Sphere Store-review gateway and API
After=network.target sphere-review-demo-moodle.service
Requires=sphere-review-demo-moodle.service

[Service]
Type=simple
WorkingDirectory=/home/fldadmin/sphere-review-demo/server
Environment=SPHERE_REVIEW_DEMO_HOME=/home/fldadmin/sphere-review-demo
Environment=DATABASE_URL=sqlite+pysqlite:////home/fldadmin/sphere-review-demo/sphere.db
Environment=ATTACHMENT_STORAGE_DIR=/home/fldadmin/sphere-review-demo/attachments
Environment=EXTENSION_REDIRECT_URIS=https://mohajifpffgbmkelnpdibcebmjpjngak.chromiumapp.org/
ExecStart=/home/fldadmin/sphere-review-demo/venv/bin/python -m uvicorn app.reviewer_demo:build_demo --factory --host 127.0.0.1 --port 8023 --no-access-log
Restart=on-failure
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
